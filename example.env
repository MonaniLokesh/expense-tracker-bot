# Supabase
SUPABASE_URL=https://your-project.supabase.co
# Use service_role secret (NOT anon) — backend needs to bypass RLS
SUPABASE_KEY=your_service_role_secret

# Groq (LangChain reads GROQ_API_KEY automatically)
GROQ_API_KEY=gsk_your_key_here

# Twilio WhatsApp
TWILIO_ACCOUNT_SID=ACxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
# Local: ngrok URL. Render: https://your-app.onrender.com (no trailing slash)
WEBHOOK_BASE_URL=https://your-subdomain.ngrok-free.app

# Server port (default 5000)
PORT=5000
